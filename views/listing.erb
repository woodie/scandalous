<!DOCTYPE html>
<html>
<head>
  <title>Available Scans</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <h2>Available Scans</h2>
  <% if @listing.empty? %>
    <p>No files found in the directory.</p>
  <% else %>
    <ul>
      <% @listing.each do |file| %>
        <li>
          <button type="button" class="delete" onclick="deleteFile('<%= file[:name] %>',
          '<%= "Delete this scan from #{time_ago file[:time]}?" %>')">🗑</button>
          <a href="/download/<%= file[:name] %>">📄 <%= human_size file[:size] %></a>
          <span><%= time_ago file[:time] %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
  <script>
    function deleteFile(name, confirmMessage) {
      if (!confirm(confirmMessage)) return;
      fetch('/download/' + encodeURIComponent(name), { method: 'DELETE' })
        .then(function (res) {
          if (res.ok) {
            location.reload();
          } else {
            alert('Delete failed.');
          }
        })
        .catch(function () {
          alert('Delete failed.');
        });
    }
  </script>
</body>
</html>
