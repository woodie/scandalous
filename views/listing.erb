<!DOCTYPE html>
<html>
<head>
  <title>Available Scans</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <h2>Available Scans</h2>
  <% if @listing.empty? %>
    <p>No files found in the directory.</p>
  <% else %>
    <ul>
      <% @listing.each do |file| %>
        <li>
          <button type="button" class="delete" onclick="deleteFile('<%= file[:name] %>',
          '<%= "Delete this scan from #{time_ago_in_words file[:time]}?" %>')">🗑</button>
          <a href="/download/<%= file[:name] %>">📄 <%= number_to_human_size file[:size] %></a>
          <span><%= time_ago_in_words file[:time] %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
  <script src="script.js"></script>
</body>
</html>
