<!DOCTYPE html>
<html>
<head>
  <title>File Server</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <h2>Available Scans</h2>
  <% if @files.empty? %>
    <p>No files found in the directory.</p>
  <% else %>
    <ul>
      <% @files.each do |file| %>
        <li>
          <a href="/download/<%= file[:name] %>">📄 <%= file[:size] %></a>
          <span><%= file[:date] %> ago</span>
        </li>
      <% end %>
    </ul>
  <% end %>
</body>
</html>
